import tkinter as tk
from Tarea import Tarea
from Robot import robot

def escribir_registro(registro, mensaje):
    registro.insert(tk.END, mensaje + "\n")
    registro.see(tk.END)


def mostrar_pila(lista_pila, robot):
    lista_pila.delete(0, tk.END)

    if robot.tarea_actual is not None:
        texto = "EJECUTANDO: "
        texto += robot.tarea_actual.nombre
        texto += " - " + robot.tarea_actual.tipo

        lista_pila.insert(tk.END, texto)

    posicion = len(robot.pila_tareas)
    
    for tarea in reversed(robot.pila_tareas):
        texto = "Tarea " + str(posicion) + ": "
        texto += tarea.nombre
        texto += " - " + tarea.tipo
        texto += " (" + str(tarea.tiempo_ejecucion) + " segundos)"

        lista_pila.insert(tk.END, texto)
        posicion -= 1
    
def agregar_tarea(nombre_var, tipo_var, tiempo_var, estado_var, lista_pila, registro, robot):

    nombre = nombre_var.get()
    tipo = tipo_var.get()
    tiempo = tiempo_var.get()

    if nombre == "" or tipo == "" or tiempo == "":
        estado_var.set("Debe llenar todos los datos de la tarea")
        return

    if not tiempo.isdigit():
        estado_var.set("El tiempo debe ser un número entero")
        return
    tiempo = int(tiempo)

    if tiempo <= 0:
        estado_var.set("El tiempo debe ser mayor que cero")
        return

    tarea = Tarea(nombre, tipo, tiempo)

    # Llamada al método del objeto Robot.
    robot.agregar_tarea(tarea)

    escribir_registro(registro,"Se agregó a la pila: " + tarea.nombre + " - Tipo: " + tarea.tipo)

    nombre_var.set("")
    tiempo_var.set("")

    mostrar_pila(lista_pila, robot)

    estado_var.set("Tarea agregada. En pila: " + str(len(robot.pila_tareas)))


def iniciar_simulacion(ventana, estado_var, lista_pila,registro, robot):

    if robot.ejecutando:
        estado_var.set("El robot ya está ejecutando tareas")
        return

    if robot.tarea_actual is None and not robot.hay_tareas():
        estado_var.set("No hay tareas en la pila")
        escribir_registro(registro, "No hay tareas para ejecutar.")
        return

    robot.ejecutando = True

    escribir_registro(registro, "Simulación iniciada.")

    ejecutar_siguiente_tarea(ventana,estado_var,lista_pila,registro,robot)


def detener_simulacion(estado_var, registro, robot):
    if robot.ejecutando:
        robot.ejecutando = False

        estado_var.set("Simulación detenida")
        escribir_registro(registro, "La simulación fue detenida.")
    else:
        estado_var.set("No hay una simulación activa")


def ejecutar_siguiente_tarea(ventana, estado_var,lista_pila, registro, robot):

    if not robot.ejecutando:
        return

    # Si no hay tarea actual, se toma la tarea de la parte de arriba
    if robot.tarea_actual is None:

        if not robot.sacar_tarea():
            robot.ejecutando = False

            estado_var.set("No hay más tareas en la pila")

            escribir_registro(registro,"El robot terminó todas sus tareas.")

            mostrar_pila(lista_pila, robot)
            return

        escribir_registro(registro,"Iniciando tarea: " + robot.tarea_actual.nombre)

    tarea = robot.tarea_actual

    estado_var.set("Ejecutando: " + tarea.nombre +" - Tipo: " + tarea.tipo +" - Duración: " + str(tarea.tiempo_ejecucion) +" segundos")
    mostrar_pila(lista_pila, robot)

    # after espera el tiempo indicado sin bloquear la ventana.
    ventana.after(tarea.tiempo_ejecucion * 1000,terminar_y_continuar,ventana,estado_var,lista_pila,registro,robot)


def terminar_y_continuar(ventana, estado_var,lista_pila, registro, robot):

    if not robot.ejecutando:
        return

    tarea_terminada = robot.tarea_actual

    escribir_registro(registro,"Tarea terminada: " + tarea_terminada.nombre)

    robot.terminar_tarea()

    mostrar_pila(lista_pila, robot)

    ejecutar_siguiente_tarea(ventana, estado_var,lista_pila,registro,robot)


